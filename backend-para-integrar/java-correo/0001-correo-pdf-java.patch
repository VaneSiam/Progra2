+const express=require('express');
+const crear=require('../Proyecto_final_progra2/service/comprobante-correo');
+function fixture() {
+  const estados=new Map(); let envios=0, ultimo;
+  const usuario={id_usuario:2,nombre_usuario:'vendedor',contrasena_hash:'clave-prueba',nombre_completo:'Prueba',rol:'vendedor',status:true};
+  const venta={id_venta:8,id_vendedor:2,total_venta:250};
+  let detalles=[{id_venta:8,id_cliente:3,cantidad:1,precio_unitario:100,subtotal:100},{id_venta:8,id_cliente:3,cantidad:1,precio_unitario:150,subtotal:150}];
+  const cliente={correo:'cliente@example.invalid'};
+  const db={usuario:{findOne:async()=>usuario,findByPk:async()=>usuario},ventas:{findByPk:async id=>id===8?venta:null},
+    d_ventas:{findAll:async()=>detalles},cliente:{findByPk:async()=>cliente},comprobanteCorreo:{
+      findByPk:async id=>estados.get(id),
+      findOrCreate:async({where,defaults})=>{if(!estados.has(where.id_venta))estados.set(where.id_venta,{...defaults});return [estados.get(where.id_venta)];},
+      update:async(values,{where})=>{const row=estados.get(where.id_venta);if(!row || row.estado!==where.estado)return [0];Object.assign(row,values);return [1];}
+    }};
+  const env={COMPROBANTE_JAVA_ENABLED:'true',COMPROBANTE_SESSION_SECRET:'s'.repeat(32),MAIL_FROM:'sender@example.invalid'};
+  let transportar=async m=>({accepted:[m.to],messageId:'gmail-prueba'});
+  const crearTransporte=()=>({sendMail:async m=>{envios++;ultimo=m;return transportar(m);}});
+  function app() {const a=express();a.use(express.json({limit:'7mb'}));crear({db,env,crearTransporte}).registrar(a);return a;}
+  return {app,db,env,usuario,venta,cliente,estados,get envios(){return envios;},get ultimo(){return ultimo;},
+    set detalles(v){detalles=v;},set transportar(v){transportar=v;}};
+}
+
+module.exports=fixture;
