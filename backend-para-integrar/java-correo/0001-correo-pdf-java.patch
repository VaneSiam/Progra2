+const {test}=require('node:test');
+const assert=require('node:assert/strict');
+const express=require('express');
+const bcrypt=require('bcryptjs');
+const crear=require('../Proyecto_final_progra2/service/comprobante-correo');
+
+const fixture=require('./fixture.cjs');
+const pdf=Buffer.from('%PDF-1.4\nPrueba de transporte; PDF real en prueba Java.\n%%EOF\n');
+async function servidor(f,run) {
+  const s=f.app().listen(0,'127.0.0.1');await new Promise(r=>s.once('listening',r));
+  const base='http://127.0.0.1:'+s.address().port;
+  const req=async(path,method='GET',body,token)=>{
+    const r=await fetch(base+'/api/comprobantes'+path,{method,headers:{'Content-Type':'application/json',...(token?{Authorization:'Bearer '+token}:{})},body:body===undefined?undefined:JSON.stringify(body)});
+    return {status:r.status,body:await r.json()};
+  };
+  try {await run(req);}finally{await new Promise(r=>s.close(r));}
+}
+async function token(req) {const r=await req('/login','POST',{nombre_usuario:'vendedor',contrasena:'clave-prueba'});assert.equal(r.status,200);assert(!JSON.stringify(r.body).includes('contrasena'));return r.body.token;}
+const enviar=(req,t,extra={})=>req('/8/correo','POST',{pdf_base64:pdf.toString('base64'),...extra},t);
+
+test('autenticación, pertenencia, adjunto y destinatario desde BD; idempotencia persistente',async()=>{
+ const f=fixture();
+ await servidor(f,async req=>{
+  assert.equal((await enviar(req)).status,401);
+  assert.equal((await req('/login','POST',{nombre_usuario:'vendedor',contrasena:'mala'})).status,401);
+  f.usuario.contrasena_hash=await bcrypt.hash('clave-prueba',4);
+  const t=await token(req);
+  assert.equal((await enviar(req,t+'x')).status,401);
+  f.venta.id_vendedor=99;assert.equal((await enviar(req,t)).status,403);f.venta.id_vendedor=2;
+  assert.equal((await enviar(req,t,{pdf_base64:'bm8='})).status,400);
+  assert.equal((await enviar(req,t,{pdf_base64:'!!!!'})).status,400);
+  const r=await enviar(req,t,{to:'atacante@example.invalid'});assert.equal(r.status,200);
+  assert.equal(f.ultimo.to,'cliente@example.invalid');assert.deepEqual(f.ultimo.attachments[0].content,pdf);assert(!f.ultimo.bcc);
+  assert.equal((await enviar(req,t)).body.reutilizado,true);assert.equal(f.envios,1);
+  assert.equal((await req('/8/correo','GET',undefined,t)).body.estado,'aceptado');
+ });
+ await servidor(f,async req=>{assert.equal((await enviar(req,await token(req))).body.reutilizado,true);assert.equal(f.envios,1);});
+});
+test('dos solicitudes simultáneas reservan un solo envío',async()=>{
+ const f=fixture();let terminar;f.transportar=m=>new Promise(r=>{terminar=()=>r({accepted:[m.to],messageId:'uno'});});
+ await servidor(f,async req=>{
+  const t=await token(req);const primera=enviar(req,t);
+  while(!terminar)await new Promise(r=>setTimeout(r,5));
+  try {assert.equal((await enviar(req,t)).status,409);assert.equal(f.envios,1);}finally{terminar();}
+  assert.equal((await primera).status,200);
+ });
+});
+test('venta incompleta, total inconsistente y correo inválido nunca envían',async()=>{
+ const f=fixture();await servidor(f,async req=>{const t=await token(req);
+  f.venta.total_venta=999;assert.equal((await enviar(req,t)).status,409);f.venta.total_venta=250;
+  f.cliente.correo='invalido';assert.equal((await enviar(req,t)).status,409);f.cliente.correo='cliente@example.invalid';
+  f.detalles=[];assert.equal((await enviar(req,t)).status,409);assert.equal(f.envios,0);
+ });
+});
+test('timeout conserva estado incierto y bloquea duplicados; rechazo confirmado permite reintentar',async()=>{
+ const f=fixture();f.transportar=async()=>{throw new Error('timeout simulado');};
+ await servidor(f,async req=>{const t=await token(req);assert.equal((await enviar(req,t)).status,503);assert.equal(f.estados.get(8).estado,'incierto');assert.equal((await enviar(req,t)).status,409);assert.equal(f.envios,1);});
+ const g=fixture();g.transportar=async()=>{throw Object.assign(new Error('rechazo'),{response:{status:429}});};
+ await servidor(g,async req=>{const t=await token(req);assert.equal((await enviar(req,t)).status,503);assert.equal(g.estados.get(8).estado,'pendiente');g.transportar=async m=>({accepted:[m.to],messageId:'reintento'});assert.equal((await enviar(req,t)).status,200);assert.equal(g.envios,2);});
+});
+test('configuración pendiente no envía ni altera ventas',async()=>{
+ const f=fixture();await servidor(f,async req=>{const t=await token(req);f.env.MAIL_FROM='';assert.equal((await enviar(req,t)).status,503);assert.equal(f.envios,0);assert.equal(f.estados.size,0);f.env.COMPROBANTE_JAVA_ENABLED='false';assert.equal((await enviar(req,t)).status,503);});
+});
