diff --git a/Proyecto_final_progra2/service/comprobante-correo.js b/Proyecto_final_progra2/service/comprobante-correo.js
new file mode 100644
index 0000000..66e94d2
--- /dev/null
+++ b/Proyecto_final_progra2/service/comprobante-correo.js
@@ -0,0 +1,132 @@
+const crypto = require('node:crypto');
+const bcrypt = require('bcryptjs');
+const {rateLimit} = require('express-rate-limit');
+
+const MAX_PDF = 5 * 1024 * 1024;
+const emailValido = v => typeof v === 'string' && /^[^\s@<>]+@[^\s@<>]+\.[^\s@<>]+$/.test(v);
+const igual = (a,b) => {
+  const x=crypto.createHash('sha256').update(String(a)).digest();
+  const y=crypto.createHash('sha256').update(String(b)).digest();
+  return crypto.timingSafeEqual(x,y);
+};
+const error = (status,message) => Object.assign(new Error(message),{status});
+
+module.exports = function crearCorreo({db, env=process.env, crearTransporte=()=>require('./correo-gmail')(env)}) {
+  const secret = () => {
+    if (!env.COMPROBANTE_SESSION_SECRET || Buffer.byteLength(env.COMPROBANTE_SESSION_SECRET)<32)
+      throw error(503,'Falta configurar el servicio de comprobantes en Render.');
+    return env.COMPROBANTE_SESSION_SECRET;
+  };
+  const firma = texto => crypto.createHmac('sha256',secret()).update(texto).digest('base64url');
+  const emitir = id => {
+    const texto=Buffer.from(JSON.stringify({id,exp:Math.floor(Date.now()/1000)+8*3600})).toString('base64url');
+    return texto+'.'+firma(texto);
+  };
+  async function autenticar(req,res,next) {
+    try {
+      if (env.COMPROBANTE_JAVA_ENABLED !== 'true') throw error(503,'Envío de comprobantes pendiente de activar en Render.');
+      secret();
+      const token=(req.headers.authorization || '').replace(/^Bearer /,'');
+      const partes=token.split('.');
+      if (partes.length!==2 || token.length>600 || !igual(partes[1],firma(partes[0]))) throw error(401,'Inicia sesión nuevamente para enviar el comprobante.');
+      let dato;
+      try { dato=JSON.parse(Buffer.from(partes[0],'base64url')); } catch {throw error(401,'Sesión inválida.');}
+      if (!Number.isSafeInteger(dato.id) || !Number.isFinite(dato.exp) || dato.exp<=Date.now()/1000) throw error(401,'La sesión venció. Inicia sesión nuevamente.');
+      const usuario=await db.usuario.findByPk(dato.id);
+      if (!usuario || usuario.status===false || !['administrador','admin','vendedor'].includes(String(usuario.rol).trim().toLowerCase())) throw error(403,'Usuario sin autorización.');
+      req.usuarioCorreo=usuario; next();
+    } catch(e) { responderError(res,e); }
+  }
+  function responderError(res,e) {
+    res.status(e.status || 503).json({message:e.status ? e.message : 'No se pudo procesar el comprobante. La venta permanece registrada.'});
+  }
+  async function datos(req) {
+    const id=Number(req.params.id);
+    if (!Number.isSafeInteger(id) || id<1) throw error(400,'Número de venta inválido.');
+    const venta=await db.ventas.findByPk(id);
+    if (!venta) throw error(404,'Venta no encontrada.');
+    const rol=String(req.usuarioCorreo.rol).trim().toLowerCase();
+    if (rol==='vendedor' && Number(venta.id_vendedor)!==Number(req.usuarioCorreo.id_usuario)) throw error(403,'Solo puedes enviar tus propias ventas.');
+    return {id,venta};
+  }
+  async function clienteVenta(id,venta) {
+    const detalles=await db.d_ventas.findAll({where:{id_venta:id}});
+    if (!detalles.length) throw error(409,'La venta no tiene detalles. Revisa la compra sin volver a cobrar.');
+    const clientes=new Set(detalles.map(d=>Number(d.id_cliente)));
+    if (clientes.size!==1 || !Number.isSafeInteger([...clientes][0])) throw error(409,'La venta no tiene un cliente único.');
+    const centavos = v => {
+      const n=Number(v);
+      if(v==null || !Number.isFinite(n) || n<0) throw error(409,'Importes de venta inválidos.');
+      return Math.round(n*100);
+    };
+    let total=0;
+    for(const d of detalles) {
+      if(Number(d.cantidad)!==1 || centavos(d.precio_unitario)!==centavos(d.subtotal)) throw error(409,'Detalle de venta inconsistente.');
+      total+=centavos(d.subtotal);
+    }
+    if(total!==centavos(venta.total_venta)) throw error(409,'El total no coincide con los detalles de la venta.');
+    const cliente=await db.cliente.findByPk([...clientes][0]);
+    if (!cliente || !emailValido(cliente.correo)) throw error(409,'El cliente no tiene un correo válido. Corrígelo y reintenta el envío.');
+    return cliente;
+  }
+  function registrar(app) {
+    const loginLimit=rateLimit({windowMs:15*60*1000,limit:20,standardHeaders:true,legacyHeaders:false});
+    app.post('/api/comprobantes/login',loginLimit,async(req,res)=> {
+      res.set('Cache-Control','no-store');
+      try {
+        if(env.COMPROBANTE_JAVA_ENABLED!=='true') throw error(503,'Servicio pendiente de activar en Render.');
+        secret();
+        const {nombre_usuario,contrasena}=req.body || {};
+        if(typeof nombre_usuario!=='string' || typeof contrasena!=='string' || nombre_usuario.length>50 || contrasena.length>200 || !contrasena) throw error(400,'Credenciales inválidas.');
+        const u=await db.usuario.findOne({where:{nombre_usuario}});
+        const hash=String(u?.contrasena_hash || '');
+        // Compatibilidad con la BD actual; acepta bcrypt cuando migren sus contraseñas.
+        const valida=hash.startsWith('$2') ? await bcrypt.compare(contrasena,hash) : igual(contrasena,hash);
+        if(!u || !valida || u.status===false) throw error(401,'Usuario o contraseña incorrectos.');
+        if(!['administrador','admin','vendedor'].includes(String(u.rol).trim().toLowerCase())) throw error(403,'Usuario sin autorización.');
+        res.json({token:emitir(Number(u.id_usuario)),usuario:{id_usuario:u.id_usuario,nombre_usuario:u.nombre_usuario,nombre_completo:u.nombre_completo,rol:u.rol,status:u.status}});
+      } catch(e) {responderError(res,e);}
+    });
+    app.get('/api/comprobantes/:id/correo',autenticar,async(req,res)=> {
+      res.set('Cache-Control','no-store');
+      try {
+        const {id}=await datos(req);
+        const registro=await db.comprobanteCorreo.findByPk(id);
+        res.json({estado:registro?.estado || 'pendiente'});
+      } catch(e) {responderError(res,e);}
+    });
+    app.post('/api/comprobantes/:id/correo',autenticar,async(req,res)=> {
+      try {
+        const {id,venta}=await datos(req);
+        const cliente=await clienteVenta(id,venta);
+        const previo=await db.comprobanteCorreo.findByPk(id);
+        if(previo?.estado==='aceptado') return res.json({estado:'aceptado',reutilizado:true});
+        if(previo && previo.estado!=='pendiente') throw error(409,'Envío en proceso o resultado incierto. Revisa el registro de Gmail antes de reenviar.');
+        const base64=req.body?.pdf_base64;
+        if(typeof base64!=='string' || base64.length>Math.ceil(MAX_PDF/3)*4 || !/^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$/.test(base64)) throw error(400,'Adjunta un PDF válido de hasta 5 MiB.');
+        const pdf=Buffer.from(base64,'base64');
+        if(pdf.length<10 || pdf.length>MAX_PDF || pdf.subarray(0,5).toString()!=='%PDF-' || !pdf.subarray(-1024).includes(Buffer.from('%%EOF'))) throw error(400,'El archivo no es un PDF válido.');
+        if(!emailValido(env.MAIL_FROM)) throw error(503,'Falta configurar MAIL_FROM con el correo remitente.');
+        const transporte=crearTransporte(); // Valida la configuración antes de reservar el envío.
+        await db.comprobanteCorreo.findOrCreate({where:{id_venta:id},defaults:{estado:'pendiente'}});
+        const [reservado]=await db.comprobanteCorreo.update({estado:'enviando',pdf_sha256:crypto.createHash('sha256').update(pdf).digest('hex')},{where:{id_venta:id,estado:'pendiente'}});
+        if(reservado!==1) throw error(409,'El comprobante ya está enviado o en proceso. Consulta su estado.');
+        try {
+          const resultado=await transporte.sendMail({from:env.MAIL_FROM,to:cliente.correo,
+            subject:'Comprobante de venta #'+id,
+            text:'Tu compra #'+id+' está registrada. Adjuntamos el comprobante y los boletos con QR. Documento académico, no fiscal.',
+            attachments:[{filename:'comprobante-venta-'+id+'.pdf',content:pdf,contentType:'application/pdf'}]});
+          if(!resultado.accepted?.length) throw new Error('Correo no aceptado');
+          await db.comprobanteCorreo.update({estado:'aceptado',message_id:String(resultado.messageId || '').slice(0,255)},{where:{id_venta:id,estado:'enviando'}});
+          return res.json({estado:'aceptado'});
+        } catch(e) {
+          // Un timeout puede ocurrir DESPUÉS de la aceptación: no reenviar automáticamente.
+          const rechazado=[400,401,403,404,429].includes(Number(e.response?.status)) || e.code==='EENVELOPE';
+          await db.comprobanteCorreo.update({estado:rechazado?'pendiente':'incierto'},{where:{id_venta:id,estado:'enviando'}});
+          throw error(503,rechazado ? 'El correo fue rechazado. Corrige la configuración y reintenta solo el envío.' : 'No se pudo confirmar el envío. Revisa Gmail antes de reenviar; la venta sigue registrada.');
+        }
+      } catch(e) {responderError(res,e);}
+    });
+  }
+  return {registrar};
+};
diff --git a/Proyecto_final_progra2/service/correo-gmail.js b/Proyecto_final_progra2/service/correo-gmail.js
new file mode 100644
index 0000000..e3a55d7
--- /dev/null
+++ b/Proyecto_final_progra2/service/correo-gmail.js
@@ -0,0 +1,19 @@
+// Archivo nuevo: Proyecto_final_progra2/service/correo-gmail.js
+const nodemailer = require('nodemailer');
+const {google} = require('googleapis');
+module.exports = function crearCorreoGmail(env = process.env) {
+  for (const nombre of ['GOOGLE_CLIENT_ID','GOOGLE_CLIENT_SECRET','GOOGLE_REFRESH_TOKEN'])
+    if (!env[nombre]) throw new Error('Falta configurar ' + nombre + ' en Render.');
+  const oauth = new google.auth.OAuth2(env.GOOGLE_CLIENT_ID,env.GOOGLE_CLIENT_SECRET);
+  oauth.setCredentials({refresh_token:env.GOOGLE_REFRESH_TOKEN});
+  const gmail = google.gmail({version:'v1',auth:oauth});
+  const compositor = nodemailer.createTransport({streamTransport:true,buffer:true,newline:'unix'});
+  return {
+    async sendMail(mensaje) {
+      const preparado = await compositor.sendMail(mensaje);
+      const respuesta = await gmail.users.messages.send({userId:'me',requestBody:{raw:preparado.message.toString('base64url')}},{timeout:45000});
+      if (!respuesta.data.id) throw new Error('Gmail no confirmó la aceptación del mensaje.');
+      return {accepted:[mensaje.to],messageId:respuesta.data.id};
+    }
+  };
+};
