diff --git a/test/precios-localidad.test.cjs b/test/precios-localidad.test.cjs
new file mode 100644
index 0000000..a687325
--- /dev/null
+++ b/test/precios-localidad.test.cjs
@@ -0,0 +1,53 @@
+const {test}=require('node:test');const assert=require('node:assert/strict');const express=require('express');
+const {registrar}=require('../Proyecto_final_progra2/service/precios-localidad');
+function fixture() {
+ let localidades=[],inventarios=[],siguiente=1;let siguienteInv=1;let forzarFallo=false;let gate=Promise.resolve();
+ const db={
+ sequelize:{transaction:async fn=>{
+  const anterior=gate;let liberar;gate=new Promise(r=>liberar=r);await anterior;
+  const copia=structuredClone({localidades,inventarios});
+  try{return await fn({LOCK:{UPDATE:'UPDATE'}});}catch(e){localidades=copia.localidades;inventarios=copia.inventarios;throw e;}finally{liberar();}
+ }},
+ concierto:{findByPk:async id=>id===1?{id_concierto:1}:null},
+ localidades:{bulkCreate:async filas=>{localidades.push(...filas.map(f=>({...f,id_localidad:siguiente++})));return localidades;},findAll:async()=>localidades},
+ i_boletos:{count:async()=>inventarios.length,bulkCreate:async filas=>{if(forzarFallo)throw new Error('fallo simulado');inventarios.push(...filas.map(f=>({...f,id_inventario:siguienteInv++})));},
+ findAll:async()=>inventarios,
+ update:async(values,{where})=>{let n=0;for(const fila of inventarios)if(where.id_inventario.includes(fila.id_inventario)){Object.assign(fila,values);n++;}return [n];}}
+ };
+ return {db,get localidades(){return localidades;},get inventarios(){return inventarios;},set fallo(v){forzarFallo=v;}};
+}
+async function servidor(f,run) {
+ const app=express();app.use(express.json());registrar(app,f.db);const s=app.listen(0,'127.0.0.1');await new Promise(r=>s.once('listening',r));
+ const req=async(path,method='GET',body)=>{const r=await fetch('http://127.0.0.1:'+s.address().port+'/api/localidades/'+path,{method,headers:{'Content-Type':'application/json'},body:body?JSON.stringify(body):undefined});return {status:r.status,body:await r.json()};};
+ try{await run(req);}finally{await new Promise(r=>s.close(r));}
+}
+const body={id_concierto:1,precios:{VIP:'1000',Plata:'500',General:'150'}};
+test('genera exactamente 100 asientos con precios separados y evita duplicarlos',async()=>{
+ const f=fixture();await servidor(f,async req=>{
+  assert.equal((await req('configuracion-precios')).body.precios_por_localidad,true);
+  assert.equal((await req('generar-por-localidad','POST',body)).status,201);
+  assert.equal(f.localidades.length,100);assert.equal(f.inventarios.length,100);
+  for(const [tipo,n,precio]of [['VIP',10,'1000.00'],['Plata',20,'500.00'],['General',70,'150.00']]){
+   const ids=new Set(f.localidades.filter(l=>l.nombre===tipo).map(l=>l.id_localidad));assert.equal(ids.size,n);
+   assert(f.inventarios.filter(i=>ids.has(i.id_localidad)).every(i=>i.precio===precio && i.cantidad_disponible===1));
+  }
+  assert.equal((await req('generar-por-localidad','POST',body)).status,409);assert.equal(f.inventarios.length,100);
+ });
+});
+test('falla antes de escribir si el precio no es válido; revierte si falla inventario',async()=>{
+ const f=fixture();await servidor(f,async req=>{
+  assert.equal((await req('generar-por-localidad','POST',{...body,precios:{VIP:'NaN',Plata:10,General:20}})).status,400);assert.equal(f.localidades.length,0);
+  f.fallo=true;assert.equal((await req('generar-por-localidad','POST',body)).status,500);assert.equal(f.localidades.length,0);assert.equal(f.inventarios.length,0);
+ });
+});
+test('actualiza solo asientos disponibles y conserva precios de vendidos',async()=>{
+ const f=fixture();await servidor(f,async req=>{
+  await req('generar-por-localidad','POST',body);f.inventarios[0].cantidad_disponible=0;
+  const r=await req('precios/1','PUT',{precios:{VIP:1200,Plata:650,General:200}});
+  assert.equal(r.body.actualizados,99);assert.equal(f.inventarios[0].precio,'1000.00');assert.equal(f.inventarios[1].precio,'1200.00');
+  assert.equal(f.inventarios[10].precio,'650.00');assert.equal(f.inventarios[30].precio,'200.00');
+ });
+});
+test('dos solicitudes concurrentes solo generan un lote',async()=>{
+ const f=fixture();await servidor(f,async req=>{const rs=await Promise.all([req('generar-por-localidad','POST',body),req('generar-por-localidad','POST',body)]);assert.deepEqual(rs.map(r=>r.status).sort(),[201,409]);assert.equal(f.inventarios.length,100);});
+});
