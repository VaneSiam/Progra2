diff --git a/Proyecto_final_progra2/service/migrar-tarifas.js b/Proyecto_final_progra2/service/migrar-tarifas.js
new file mode 100644
index 0000000..9eb3c56
--- /dev/null
+++ b/Proyecto_final_progra2/service/migrar-tarifas.js
@@ -0,0 +1,8 @@
+// Migración aditiva e idempotente para conservar tarifas históricas; sin backfill.
+module.exports=async db=>{
+ const tabla=db.sequelize.getQueryInterface().queryGenerator.quoteTable(db.d_ventas.getTableName());
+ await db.sequelize.query(`ALTER TABLE ${tabla}
+ ADD COLUMN IF NOT EXISTS precio_base NUMERIC(10,2),
+ ADD COLUMN IF NOT EXISTS recargo_porcentaje NUMERIC(5,2),
+ ADD COLUMN IF NOT EXISTS recargo_monto NUMERIC(10,2)`);
+};
diff --git a/Proyecto_final_progra2/service/precios-localidad.js b/Proyecto_final_progra2/service/precios-localidad.js
new file mode 100644
index 0000000..864611d
--- /dev/null
+++ b/Proyecto_final_progra2/service/precios-localidad.js
@@ -0,0 +1,56 @@
+const fallo=(status,message)=>{throw Object.assign(new Error(message),{status});};
+function precios(body) {
+ const p=body?.precios;
+ if(!p || typeof p!=='object' || Array.isArray(p))fallo(400,'Completa los precios de VIP, Platea y General.');
+ const salida={};
+ for(const tipo of ['VIP','Plata','General']) {
+  const v=p[tipo];
+  if(!/^[0-9]{1,8}(?:\.[0-9]{1,2})?$/.test(String(v)) || !Number.isFinite(Number(v)) || Number(v)<=0)
+   fallo(400,'Precio de '+(tipo==='Plata'?'Platea':tipo)+': mayor que cero y hasta dos decimales.');
+  salida[tipo]=Number(v).toFixed(2);
+ }
+ return salida;
+}
+function idValido(v) {if(typeof v==='boolean' || !/^[1-9][0-9]*$/.test(String(v)) || !Number.isSafeInteger(Number(v)))fallo(400,'Selecciona un concierto válido.');return Number(v);}
+function registrar(app,db) {
+ const responder=(res,e)=>res.status(e.status || 500).json({message:e.status?e.message:'No se guardaron los precios o asientos. Revisa la conexión e inténtalo nuevamente.'});
+ app.get('/api/localidades/configuracion-precios',(_q,res)=>res.json({precios_por_localidad:true,localidades:['VIP','Plata','General'],moneda:'GTQ'}));
+ app.post('/api/localidades/generar-por-localidad',async(req,res)=>{
+  try {
+   const id=idValido(req.body?.id_concierto), tarifas=precios(req.body);
+   const resultado=await db.sequelize.transaction(async t=>{
+    const concierto=await db.concierto.findByPk(id,{transaction:t,lock:t.LOCK.UPDATE});
+    if(!concierto)fallo(404,'El concierto no existe.');
+    if(await db.i_boletos.count({where:{id_concierto:id},transaction:t}))fallo(409,'Este concierto ya tiene asientos. Usa Actualizar precios disponibles.');
+    const filas=[];
+    for(let n=0;n<100;n++)filas.push({nombre:n<10?'VIP':n<30?'Plata':'General',asiento:String.fromCharCode(65+Math.floor(n/10))+'-'+(n%10+1),estado:true});
+    const localidades=await db.localidades.bulkCreate(filas,{transaction:t,returning:true});
+    await db.i_boletos.bulkCreate(localidades.map(l=>({id_concierto:id,id_localidad:l.id_localidad,precio:tarifas[l.nombre],cantidad_total:1,cantidad_disponible:1})),{transaction:t});
+    return {asientos:100,distribucion:{VIP:10,Plata:20,General:70}};
+   });
+   res.status(201).json({precios_por_localidad:true,...resultado,precios:tarifas});
+  }catch(e){responder(res,e);}
+ });
+ app.put('/api/localidades/precios/:id',async(req,res)=>{
+  try {
+   const id=idValido(req.params.id),tarifas=precios(req.body);
+   const actualizados=await db.sequelize.transaction(async t=>{
+    const concierto=await db.concierto.findByPk(id,{transaction:t,lock:t.LOCK.UPDATE});
+    if(!concierto)fallo(404,'El concierto no existe.');
+    const inventarios=await db.i_boletos.findAll({where:{id_concierto:id},transaction:t,lock:t.LOCK.UPDATE});
+    const libres=inventarios.filter(i=>Number(i.cantidad_disponible)>0);
+    if(!libres.length)fallo(409,'No hay asientos disponibles para actualizar.');
+    const localidades=await db.localidades.findAll({where:{id_localidad:libres.map(i=>i.id_localidad)},transaction:t});
+    const tipos=new Map(localidades.map(l=>[Number(l.id_localidad),l.nombre]));
+    for(const tipo of ['VIP','Plata','General']) {
+     const ids=libres.filter(i=>tipos.get(Number(i.id_localidad))===tipo).map(i=>i.id_inventario);
+     if(ids.length)await db.i_boletos.update({precio:tarifas[tipo]},{where:{id_inventario:ids},transaction:t});
+    }
+    if(libres.some(i=>!Object.hasOwn(tarifas,tipos.get(Number(i.id_localidad)))))fallo(409,'Hay localidades desconocidas; no se cambió ningún precio.');
+    return libres.length;
+   });
+   res.json({precios_por_localidad:true,actualizados,precios:tarifas});
+  }catch(e){responder(res,e);}
+ });
+}
+module.exports={registrar,precios};
diff --git a/Proyecto_final_progra2/service/tarifas.js b/Proyecto_final_progra2/service/tarifas.js
new file mode 100644
index 0000000..71479df
--- /dev/null
+++ b/Proyecto_final_progra2/service/tarifas.js
@@ -0,0 +1,8 @@
+module.exports = function tarifa(base,localidad) {
+ const precio=Number(base);
+ if(!Number.isFinite(precio) || precio<0)throw new Error('Precio base inválido.');
+ const porcentaje=String(localidad).trim()==='VIP'?45:String(localidad).trim()==='Plata'?25:0;
+ const centavos=Math.round(precio*100);
+ const cargo=Math.round(centavos*porcentaje/100);
+ return {precio_base:centavos/100,recargo_porcentaje:porcentaje,recargo_monto:cargo/100,precio_unitario:(centavos+cargo)/100};
+};
